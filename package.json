{
  "name": "agency-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @agency-crm/api start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tests/e2e/tsconfig.json",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && playwright test",
    "db:generate": "pnpm --filter @agency-crm/api db:generate",
    "db:migrate": "pnpm --filter @agency-crm/api db:migrate",
    "db:seed:demo": "pnpm --filter @agency-crm/api db:seed:demo",
    "db:backup": "pnpm --filter @agency-crm/api db:backup",
    "auth:create-admin": "pnpm --filter @agency-crm/api auth:create-admin",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
