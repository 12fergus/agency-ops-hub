# Copy to .env and adjust. Never commit .env.
NODE_ENV=development

# Bind address. 127.0.0.1 = this PC only.
# For office use set to the host's private LAN IP (e.g. 192.168.1.10), never 0.0.0.0 on an untrusted network.
HOST=127.0.0.1
PORT=3000

# SQLite file on the host's LOCAL disk (never a network share). Relative paths resolve from the repo root.
DATABASE_PATH=data/crm.sqlite

LOG_LEVEL=info

# Backups. Relative paths resolve from the repo root. Must be local disk; copy offsite separately.
BACKUP_DIR=backups

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# auto = Secure cookie only over HTTPS. Use true once the office runs HTTPS only.
COOKIE_SECURE=auto
# true ONLY if a reverse proxy on this host terminates TLS and sets X-Forwarded-*.
TRUST_PROXY=false
# Extra allowed origins for writes (comma-separated), e.g. https://crm.office.lan
TRUSTED_ORIGINS=

# Self-signup from the login page. New accounts are employees with NO client access until assigned.
SELF_SIGNUP=true
# false = sign-up logs in immediately; true = sign-ups wait for admin approval on the users page.
SIGNUP_REQUIRES_APPROVAL=false

# First admin WITHOUT a terminal (optional; scripted installs). Used once at startup while no admin
# exists, then REMOVE INITIAL_ADMIN_PASSWORD from the config. Without these, the web shows a
# setup page that asks for the one-time code written to data/setup-code.txt.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Client photos/logos. Default: "uploads" next to DATABASE_PATH. Local disk only; back it up with the DB.
UPLOADS_DIR=
